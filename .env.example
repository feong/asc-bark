# 复制为 .env 后填写。不要把 .env 或 p8 放进镜像、仓库或日志。
# 下面的路径是容器内路径；宿主机文件由 docker compose 只读挂载。

ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_APP_ID=
ASC_PRIVATE_KEY_PATH=/secrets/AuthKey.p8
BARK_KEY=
BARK_SERVER=https://api.day.app
ASC_DATA_DIR=/data

# 常驻服务的日程，按 TZ 解释。默认每天 09:00。
# 也可以写五段 cron：分 时 日 月 周，例如 0 9 * * *
# 日和周都不是 * 时，满足其中任意一项就运行。周几用数字，0 和 7 都是星期日。
ASC_SCHEDULE=09:00
TZ=Asia/Shanghai
